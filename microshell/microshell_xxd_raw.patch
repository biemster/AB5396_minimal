+static bool ush_cmd_xxd_parse_uintmax(const char *text, uintmax_t *value)
+{
+        uintmax_t result = 0;
+        uintmax_t limit = UINTMAX_MAX;
+        unsigned int base = 10;
+        size_t index = 0;
+
+        if ((text == NULL) || (text[0] == '\0')) {
+                return false;
+        }
+
+        if ((text[0] == '0') && ((text[1] == 'x') || (text[1] == 'X'))) {
+                base = 16;
+                index = 2;
+        }
+
+        if (text[index] == '\0') {
+                return false;
+        }
+
+        for (; text[index] != '\0'; index++) {
+                unsigned int digit;
+                char ch = text[index];
+
+                if ((ch >= '0') && (ch <= '9')) {
+                        digit = (unsigned int)(ch - '0');
+                } else if ((base == 16) && (ch >= 'a') && (ch <= 'f')) {
+                        digit = (unsigned int)(ch - 'a') + 10U;
+                } else if ((base == 16) && (ch >= 'A') && (ch <= 'F')) {
+                        digit = (unsigned int)(ch - 'A') + 10U;
+                } else {
+                        return false;
+                }
+
+                if (digit >= base) {
+                        return false;
+                }
+
+                if (result > ((limit - digit) / base)) {
+                        return false;
+                }
+
+                result = (result * base) + digit;
+        }
+
+        *value = result;
+        return true;
+}
+
+static bool ush_cmd_xxd_parse_address(const char *text, uintptr_t *address)
+{
+        uintmax_t value;
+
+        if ((ush_cmd_xxd_parse_uintmax(text, &value) == false) ||
+            (value > UINTPTR_MAX)) {
+                return false;
+        }
+
+        *address = (uintptr_t)value;
+        return true;
+}
+
+static bool ush_cmd_xxd_parse_size(const char *text, size_t *size)
+{
+        uintmax_t value;
+
+        if ((ush_cmd_xxd_parse_uintmax(text, &value) == false) ||
+            (value > SIZE_MAX)) {
+                return false;
+        }
+
+        *size = (size_t)value;
+        return true;
+}
+
+static uint8_t ush_cmd_xxd_get_byte(struct ush_object *self, size_t offset)
+{
+        if (self->process_raw == false) {
+                return self->process_data[offset];
+        }
+
+        if (self->process_raw32 == false) {
+                volatile uint8_t const *address =
+                        (volatile uint8_t const *)(self->process_raw_address + offset);
+                return *address;
+        }
+
+        size_t word_index = offset / sizeof(uint32_t);
+
+        /*
+         * Keep the value in the shell object because xxd output is
+         * generated over multiple asynchronous service calls.
+         */
+        if (self->process_raw_word_index != word_index) {
+                volatile uint32_t const *address =
+                        (volatile uint32_t const *)(
+                                self->process_raw_address +
+                                (word_index * sizeof(uint32_t)));
+
+                self->process_raw_word = *address;
+                self->process_raw_word_index = word_index;
+        }
+
+        return ((uint8_t const *)&self->process_raw_word)
+                [offset % sizeof(uint32_t)];
+}
